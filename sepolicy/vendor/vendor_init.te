allow vendor_init proc_touchpanel:file { read write getattr setattr };
allow vendor_init proc_tp_apk:file { read write getattr setattr };
allow vendor_init sysfs_touchpanel:dir search;
allow vendor_init sysfs_touchpanel:file { read write getattr setattr };

allow vendor_init mtk_mmagent_exec:file { read getattr execute };
allow vendor_init mtk_nvram_exec:file { read getattr execute };
allow vendor_init mtk_pq_exec:file { read getattr execute };

allow vendor_init vendor_bluetooth_prop:property_service set;
allow vendor_init vendor_wifi_prop:property_service set;
allow vendor_init vendor_gps_prop:property_service set;
