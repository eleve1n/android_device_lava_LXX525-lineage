# MediaTek HAL services
/(vendor|system/vendor)/bin/hw/android\.hardware\.gatekeeper-service\.mitee    u:object_r:hal_gatekeeper_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.security\.keymint@3\.0-service\.mitee    u:object_r:hal_keymint_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.gnss-service\.mediatek    u:object_r:hal_gnss_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.graphics\.composer@3\.2-service    u:object_r:hal_graphics_composer_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.media\.c2@1\.2-mediatek-64b    u:object_r:mediacodec_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.mediatek\.hardware\.mmagent-service    u:object_r:mtk_mmagent_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.mediatek\.hardware\.nvram-service    u:object_r:mtk_nvram_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.mediatek\.hardware\.pq_aidl-service    u:object_r:mtk_pq_exec:s0
/(vendor|system/vendor)/bin/hw/mtkfusionrild    u:object_r:rild_exec:s0
/(vendor|system/vendor)/bin/tee-supplicant    u:object_r:tee_exec:s0
/(vendor|system/vendor)/bin/miteelog    u:object_r:miteelog_exec:s0

# Camera
/(vendor|system/vendor)/bin/hw/camerahalserver    u:object_r:cameraserver_exec:s0

# Trusted apps
/(vendor|system/vendor)/mitee/ta/.*\.ta    u:object_r:tee_data_file:s0

# Sensor nodes
/dev/hwmsensor    u:object_r:sensor_device:s0
/dev/lightsensor  u:object_r:sensor_device:s0
/dev/step_counter  u:object_r:sensor_device:s0

# GPU
/dev/mali0    u:object_r:gpu_device:s0

# Camera
/dev/camlog    u:object_r:camera_device:s0

# WiFi
/dev/wmtWifi    u:object_r:wifi_device:s0

# GPS
/dev/stp_gps    u:object_r:gps_device:s0
/dev/gps    u:object_r:gps_device:s0

# Bluetooth
/dev/stp_bt    u:object_r:bluetooth_device:s0

# Display
/sys/class/graphics/fb0/.*    u:object_r:sysfs_graphics:s0

# Touchpanel
/proc/touchpanel/.*    u:object_r:sysfs_touchpanel:s0
